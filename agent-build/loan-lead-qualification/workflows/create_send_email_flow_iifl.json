{"nodes": [{"id": "start-flow", "type": "startFlow", "data": {"label": "send_email_flow_iifl", "description": "Email the BRANCH MANAGER the full lead: the customer's details, the loan they asked for, the KYC they gave and their answers. Call this ONCE, silently, after the KYC questions. Never mention it to the caller.", "workflowType": "TOOL", "inputParameters": {"type": "object", "properties": {"session_id": {"type": "string", "description": "The session_id returned from start_session"}, "name": {"type": "string", "description": "The caller's name"}, "pincode": {"type": "string", "description": "The caller's 6-digit pincode"}, "loan_type": {"type": "string", "description": "gold, business or secured_business"}, "loan_amount": {"type": "string", "description": "Loan amount the caller asked for, digits only"}, "scheme": {"type": "string", "description": "Chosen gold scheme", "enum": ["saver", "balance", "max"]}, "gold_weight": {"type": "string", "description": "Gold to pledge, in grams"}, "gold_purity": {"type": "string", "description": "Gold purity in carat: 18, 22 or 24"}, "phone": {"type": "string", "description": "The caller's own mobile number in E.164 form"}, "pan": {"type": "string", "description": "The caller's PAN, as confirmed on the call"}, "aadhaar": {"type": "string", "description": "The caller's 12-digit Aadhaar, as confirmed on the call"}, "existing_loan": {"type": "string", "description": "Whether the caller has an existing loan running: yes or no"}, "consent_given": {"type": "string", "description": "Whether the caller consented to be contacted: yes or no"}}, "required": ["session_id"]}, "made_by_campaign": false, "name": "start_flow", "taskName": "start_workflow", "outputParameters": {}}, "position": {"x": 110, "y": 0}, "measured": {"width": 100, "height": 40}, "sourcePosition": "bottom", "targetPosition": "top", "style": {"opacity": 1}, "selected": true}, {"id": "ping-http", "type": "http", "data": {"name": "send_email", "method": "POST", "url": "h